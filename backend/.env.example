# Local HTTP/WebSocket server
HOST=127.0.0.1
PORT=4000

# Price source: websocket | tradingview | rest
BTC_SOURCE=websocket

# Safety gate. Keep false for normal development and paper trading.
ALLOW_LIVE_MODE=false

# Live execution credentials. Leave unset for demo/paper mode.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=/absolute/path/outside-the-repository/kalshi-private-key.pem

# Optional V13 paper learner controls
V13_TARGET_BET=1.80
V13_POLL_MS=2000
V13_RETRAIN_INTERVAL_MS=86400000
V13_MIN_NEW_ROWS=10

# Optional replay overrides
# ONLY=V1
# DATA_FILE=real_data_15m.jsonl
# TARGET=5.50
# TP=2.00
# SL=-2.50
# NEAR_STRIKE=35
